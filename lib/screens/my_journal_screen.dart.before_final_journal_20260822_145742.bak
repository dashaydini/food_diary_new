import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import '../core/services/premium_service.dart';
import '../theme/colors.dart';
import 'place_details_screen.dart';

class MyJournalScreen extends StatefulWidget {
  const MyJournalScreen({super.key});

  @override
  State<MyJournalScreen> createState() => _MyJournalScreenState();
}

class _MyJournalScreenState extends State<MyJournalScreen> {
  final SupabaseClient _client = Supabase.instance.client;

  bool _loading = true;
  String? _error;
  List<Map<String, dynamic>> _entries = [];

  @override
  void initState() {
    super.initState();
    _loadJournal();
  }

  Future<void> _loadJournal() async {
    if (!PremiumService.isPremium) {
      if (!mounted) return;
      setState(() => _loading = false);
      return;
    }

    final user = _client.auth.currentUser;

    if (user == null || user.isAnonymous) {
      if (!mounted) return;
      setState(() => _loading = false);
      return;
    }

    try {
      final rows = await _client
          .from('visits')
          .select(
            'id, place_id, created_at, food_rating, drink_rating, '
            'atmosphere_rating, service_rating, cleanliness_rating, '
            'variety_rating, value_rating, drink, drink_price, image_url, '
            'places(id, name, address, image_url)',
          )
          .eq('user_id', user.id)
          .order('created_at', ascending: false);

      if (!mounted) return;

      setState(() {
        _entries = List<Map<String, dynamic>>.from(rows as List);
        _loading = false;
        _error = null;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = e.toString();
      });
    }
  }

  String _formatDate(String? value) {
    if (value == null || value.isEmpty) return '';

    final date = DateTime.tryParse(value);
    if (date == null) return '';

    final local = date.toLocal();

    const months = [
      'ינואר',
      'פברואר',
      'מרץ',
      'אפריל',
      'מאי',
      'יוני',
      'יולי',
      'אוגוסט',
      'ספטמבר',
      'אוקטובר',
      'נובמבר',
      'דצמבר',
    ];

    return '${local.day} ${months[local.month - 1]} ${local.year}';
  }

  double? _averageRating(Map<String, dynamic> visit) {
    final values = [
      visit['food_rating'],
      visit['drink_rating'],
      visit['atmosphere_rating'],
      visit['service_rating'],
      visit['cleanliness_rating'],
      visit['variety_rating'],
      visit['value_rating'],
    ]
        .map((value) => (value as num?)?.toDouble())
        .whereType<double>()
        .where((value) => value > 0)
        .toList();

    if (values.isEmpty) return null;

    return values.reduce((a, b) => a + b) / values.length;
  }

  void _openVisit(Map<String, dynamic> visit) {
    final place = visit['places'] is Map
        ? Map<String, dynamic>.from(visit['places'] as Map)
        : <String, dynamic>{};

    final placeId = visit['place_id']?.toString();

    if (placeId == null || placeId.isEmpty) return;

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => PlaceDetailsScreen(
          place: place,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (!PremiumService.isPremium) {
      return Scaffold(
        backgroundColor: AppColors.background,
        appBar: _buildAppBar(),
        body: const Center(
          child: Padding(
            padding: EdgeInsets.all(32),
            child: Text(
              'היומן האישי זמין למשתמשי Premium.',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: AppColors.muted,
                fontSize: 17,
              ),
            ),
          ),
        ),
      );
    }

    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: _buildAppBar(),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: _buildBody(),
      ),
    );
  }

  PreferredSizeWidget _buildAppBar() {
    return AppBar(
      backgroundColor: AppColors.background,
      elevation: 0,
      centerTitle: false,
      titleSpacing: 24,
      title: const Text(
        'היומן שלי',
        style: TextStyle(
          color: AppColors.ink,
          fontSize: 25,
          fontWeight: FontWeight.w500,
        ),
      ),
      iconTheme: const IconThemeData(
        color: AppColors.ink,
      ),
    );
  }

  Widget _buildBody() {
    if (_loading) {
      return const Center(
        child: CircularProgressIndicator(
          strokeWidth: 1.5,
          color: AppColors.brass,
        ),
      );
    }

    if (_error != null) {
      return Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'לא ניתן לטעון את היומן',
              style: TextStyle(
                color: AppColors.ink,
                fontSize: 16,
              ),
            ),
            const SizedBox(height: 12),
            TextButton(
              onPressed: () {
                setState(() {
                  _loading = true;
                  _error = null;
                });
                _loadJournal();
              },
              child: const Text('נסה שוב'),
            ),
          ],
        ),
      );
    }

    if (_entries.isEmpty) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(32),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Icon(
                Icons.menu_book_outlined,
                size: 42,
                color: AppColors.brass,
              ),
              SizedBox(height: 18),
              Text(
                'היומן שלך עדיין ריק',
                style: TextStyle(
                  color: AppColors.ink,
                  fontSize: 21,
                  fontWeight: FontWeight.w500,
                ),
              ),
              SizedBox(height: 8),
              Text(
                'כל ביקור שתוסיף באפליקציה יופיע כאן.',
                textAlign: TextAlign.center,
                style: TextStyle(
                  color: AppColors.muted,
                  fontSize: 14,
                  height: 1.5,
                ),
              ),
            ],
          ),
        ),
      );
    }

    return RefreshIndicator(
      color: AppColors.brass,
      onRefresh: _loadJournal,
      child: ListView.separated(
        padding: const EdgeInsets.fromLTRB(24, 12, 24, 40),
        itemCount: _entries.length,
        separatorBuilder: (_, __) => const SizedBox(height: 0),
        itemBuilder: (context, index) {
          return _buildJournalEntry(_entries[index]);
        },
      ),
    );
  }

  Widget _buildJournalEntry(Map<String, dynamic> visit) {
    final place = visit['places'] is Map
        ? Map<String, dynamic>.from(visit['places'] as Map)
        : <String, dynamic>{};

    final placeName = place['name']?.toString().trim().isNotEmpty == true
        ? place['name'].toString()
        : 'מקום ללא שם';

    final address = place['address']?.toString().trim() ?? '';

    final visitImage = visit['image_url']?.toString() ?? '';
    final placeImage = place['image_url']?.toString() ?? '';

    final imageUrl = visitImage.trim().isNotEmpty ? visitImage : placeImage;

    final rating = _averageRating(visit);

    return InkWell(
      onTap: () => _openVisit(visit),
      borderRadius: BorderRadius.circular(18),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 18),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.center,
          children: [
            _buildThumbnail(imageUrl),
            const SizedBox(width: 16),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.end,
                children: [
                  Text(
                    placeName,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    textAlign: TextAlign.right,
                    style: const TextStyle(
                      color: AppColors.ink,
                      fontSize: 18,
                      fontWeight: FontWeight.w500,
                      height: 1.2,
                    ),
                  ),
                  if (address.isNotEmpty) ...[
                    const SizedBox(height: 5),
                    Text(
                      address,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      textAlign: TextAlign.right,
                      style: const TextStyle(
                        color: AppColors.muted,
                        fontSize: 12,
                      ),
                    ),
                  ],
                  const SizedBox(height: 10),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text(
                        _formatDate(visit['created_at']?.toString()),
                        style: const TextStyle(
                          color: AppColors.muted,
                          fontSize: 11.5,
                        ),
                      ),
                      if (rating != null)
                        Directionality(
                          textDirection: TextDirection.ltr,
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              const Icon(
                                Icons.star,
                                size: 15,
                                color: AppColors.brass,
                              ),
                              const SizedBox(width: 4),
                              Text(
                                rating.toStringAsFixed(1),
                                style: const TextStyle(
                                  color: AppColors.ink,
                                  fontSize: 12,
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ],
                          ),
                        ),
                    ],
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildThumbnail(String imageUrl) {
    return Container(
      width: 78,
      height: 78,
      decoration: BoxDecoration(
        color: AppColors.card,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: AppColors.brass.withValues(alpha: 0.18),
          width: 0.7,
        ),
      ),
      clipBehavior: Clip.antiAlias,
      child: imageUrl.trim().isEmpty
          ? const Icon(
              Icons.place_outlined,
              size: 25,
              color: AppColors.brass,
            )
          : Image.network(
              imageUrl,
              fit: BoxFit.cover,
              errorBuilder: (_, __, ___) {
                return const Icon(
                  Icons.place_outlined,
                  size: 25,
                  color: AppColors.brass,
                );
              },
            ),
    );
  }
}
