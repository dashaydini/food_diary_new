import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import '../core/services/premium_service.dart';
import '../theme/colors.dart';

class MyJournalScreen extends StatefulWidget {
  const MyJournalScreen({super.key});

  @override
  State<MyJournalScreen> createState() => _MyJournalScreenState();
}

class _MyJournalScreenState extends State<MyJournalScreen> {
  final _client = Supabase.instance.client;

  bool _loading = true;
  String? _error;
  List<Map<String, dynamic>> _entries = [];

  @override
  void initState() {
    super.initState();
    _loadJournal();
  }

  Future<void> _loadJournal() async {
    if (!PremiumService.isPremium) {
      if (mounted) {
        setState(() {
          _loading = false;
        });
      }
      return;
    }

    final user = _client.auth.currentUser;

    if (user == null || user.isAnonymous) {
      if (mounted) {
        setState(() {
          _loading = false;
        });
      }
      return;
    }

    try {
      final rows = await _client
          .from('visits')
          .select(
            'id, place_id, created_at, food_rating, drink_rating, '
            'atmosphere_rating, service_rating, cleanliness_rating, '
            'variety_rating, value_rating, drink, drink_price, '
            'image_url, places(id, name, address, image_url)',
          )
          .eq('user_id', user.id)
          .order('created_at', ascending: false);

      if (!mounted) return;

      setState(() {
        _entries = List<Map<String, dynamic>>.from(rows as List);
        _loading = false;
        _error = null;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = e.toString();
      });
    }
  }

  String _formatDate(String? value) {
    if (value == null || value.isEmpty) return '';

    final date = DateTime.tryParse(value);

    if (date == null) return '';

    final local = date.toLocal();

    const months = [
      'ינואר',
      'פברואר',
      'מרץ',
      'אפריל',
      'מאי',
      'יוני',
      'יולי',
      'אוגוסט',
      'ספטמבר',
      'אוקטובר',
      'נובמבר',
      'דצמבר',
    ];

    return '${local.day} ${months[local.month - 1]} ${local.year}';
  }

  double? _averageRating(Map<String, dynamic> visit) {
    final values = [
      visit['food_rating'],
      visit['drink_rating'],
      visit['atmosphere_rating'],
      visit['service_rating'],
      visit['cleanliness_rating'],
      visit['variety_rating'],
      visit['value_rating'],
    ]
        .map((value) => (value as num?)?.toDouble())
        .whereType<double>()
        .where((value) => value > 0)
        .toList();

    if (values.isEmpty) return null;

    return values.reduce((a, b) => a + b) / values.length;
  }

  @override
  Widget build(BuildContext context) {
    if (!PremiumService.isPremium) {
      return Scaffold(
        backgroundColor: AppColors.background,
        appBar: AppBar(
          backgroundColor: AppColors.background,
          elevation: 0,
          title: const Text('היומן שלי'),
        ),
        body: const Center(
          child: Padding(
            padding: EdgeInsets.all(32),
            child: Text(
              'היומן האישי זמין למשתמשי Premium.',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: AppColors.muted,
                fontSize: 17,
              ),
            ),
          ),
        ),
      );
    }

    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        backgroundColor: AppColors.background,
        elevation: 0,
        title: const Text('היומן שלי'),
      ),
      body: _buildBody(),
    );
  }

  Widget _buildBody() {
    if (_loading) {
      return const Center(
        child: CircularProgressIndicator(),
      );
    }

    if (_error != null) {
      return Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'לא ניתן לטעון את היומן',
              style: TextStyle(
                color: Colors.white,
              ),
            ),
            const SizedBox(height: 12),
            OutlinedButton(
              onPressed: () {
                setState(() {
                  _loading = true;
                  _error = null;
                });
                _loadJournal();
              },
              child: const Text('נסה שוב'),
            ),
          ],
        ),
      );
    }

    if (_entries.isEmpty) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(32),
          child: Text(
            'עדיין אין לך ביקורים ביומן.\n\nהוספת ביקור למקום תופיע כאן אוטומטית.',
            textAlign: TextAlign.center,
            style: TextStyle(
              color: AppColors.muted,
              fontSize: 16,
              height: 1.5,
            ),
          ),
        ),
      );
    }

    return RefreshIndicator(
      onRefresh: _loadJournal,
      child: ListView.builder(
        padding: const EdgeInsets.fromLTRB(18, 18, 18, 32),
        itemCount: _entries.length,
        itemBuilder: (context, index) {
          return _buildEntry(_entries[index]);
        },
      ),
    );
  }

  Widget _buildEntry(Map<String, dynamic> visit) {
    final place = visit['places'] is Map
        ? Map<String, dynamic>.from(visit['places'] as Map)
        : <String, dynamic>{};

    final placeName = place['name']?.toString() ?? 'מקום ללא שם';
    final address = place['address']?.toString() ?? '';

    final visitImage = visit['image_url']?.toString() ?? '';
    final placeImage = place['image_url']?.toString() ?? '';
    final imageUrl = visitImage.isNotEmpty ? visitImage : placeImage;

    final rating = _averageRating(visit);

    return Container(
      margin: const EdgeInsets.only(bottom: 18),
      decoration: BoxDecoration(
        color: AppColors.card,
        borderRadius: BorderRadius.circular(22),
        border: Border.all(
          color: const Color(0xFF555555),
        ),
      ),
      clipBehavior: Clip.antiAlias,
      child: Directionality(
        textDirection: TextDirection.rtl,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            if (imageUrl.isNotEmpty)
              SizedBox(
                height: 190,
                child: Image.network(
                  imageUrl,
                  fit: BoxFit.cover,
                  errorBuilder: (_, __, ___) {
                    return const Icon(
                      Icons.image_outlined,
                      size: 42,
                      color: AppColors.muted,
                    );
                  },
                ),
              ),
            Padding(
              padding: const EdgeInsets.fromLTRB(18, 16, 18, 18),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.end,
                children: [
                  Text(
                    placeName,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    textAlign: TextAlign.right,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 21,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  if (address.isNotEmpty) ...[
                    const SizedBox(height: 6),
                    Text(
                      address,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      textAlign: TextAlign.right,
                      style: const TextStyle(
                        color: AppColors.muted,
                        fontSize: 13,
                      ),
                    ),
                  ],
                  const SizedBox(height: 12),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text(
                        _formatDate(visit['created_at']?.toString()),
                        style: const TextStyle(
                          color: AppColors.muted,
                          fontSize: 13,
                        ),
                      ),
                      if (rating != null)
                        Directionality(
                          textDirection: TextDirection.ltr,
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              const Icon(
                                Icons.star,
                                size: 18,
                                color: Color(0xFFF5EEE6),
                              ),
                              const SizedBox(width: 5),
                              Text(
                                rating.toStringAsFixed(1),
                                style: const TextStyle(
                                  color: Color(0xFFF5EEE6),
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ],
                          ),
                        ),
                    ],
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
