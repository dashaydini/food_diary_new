import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import '../core/services/premium_service.dart';
import '../theme/colors.dart';
import '../widgets/home_button.dart';

class JournalScreen extends StatefulWidget {
  const JournalScreen({super.key});

  @override
  State<JournalScreen> createState() => _JournalScreenState();
}

class _JournalScreenState extends State<JournalScreen> {
  final SupabaseClient _client = Supabase.instance.client;

  List<Map<String, dynamic>> _visits = [];
  bool _loading = true;
  String? _error;

  @override
  void initState() {
    super.initState();
    _loadVisits();
  }

  Future<void> _loadVisits() async {
    final user = _client.auth.currentUser;

    if (user == null || user.isAnonymous || !PremiumService.isPremium) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _visits = [];
      });
      return;
    }

    try {
      final rows = await _client
          .from('visits')
          .select(
            'id, place_id, created_at, food_rating, drink_rating, '
            'atmosphere_rating, service_rating, cleanliness_rating, '
            'variety_rating, value_rating, drink, drink_price, '
            'image_url, places(id, name, address, image_url)',
          )
          .eq('user_id', user.id)
          .order('created_at', ascending: false);

      if (!mounted) return;

      setState(() {
        _visits = List<Map<String, dynamic>>.from(rows as List);
        _loading = false;
        _error = null;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = e.toString();
      });
    }
  }

  String _formatDate(String? value) {
    if (value == null || value.isEmpty) return '';

    final date = DateTime.tryParse(value);
    if (date == null) return '';

    final local = date.toLocal();

    const months = [
      'ינואר',
      'פברואר',
      'מרץ',
      'אפריל',
      'מאי',
      'יוני',
      'יולי',
      'אוגוסט',
      'ספטמבר',
      'אוקטובר',
      'נובמבר',
      'דצמבר',
    ];

    return '${local.day} ${months[local.month - 1]} ${local.year}';
  }

  double? _averageRating(Map<String, dynamic> visit) {
    final values = [
      visit['food_rating'],
      visit['drink_rating'],
      visit['atmosphere_rating'],
      visit['service_rating'],
      visit['cleanliness_rating'],
      visit['variety_rating'],
      visit['value_rating'],
    ]
        .map((value) => (value as num?)?.toDouble())
        .whereType<double>()
        .where((value) => value > 0)
        .toList();

    if (values.isEmpty) return null;

    return values.reduce((a, b) => a + b) / values.length;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        backgroundColor: AppColors.background,
        elevation: 0,
        centerTitle: false,
        title: const Text(
          'היומן שלי',
          textDirection: TextDirection.rtl,
          style: TextStyle(
            color: AppColors.ink,
            fontSize: 22,
            fontWeight: FontWeight.w500,
          ),
        ),
        actions: const [
          HomeButton(),
          SizedBox(width: 8),
        ],
      ),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: _buildBody(),
      ),
    );
  }

  Widget _buildBody() {
    if (!PremiumService.isPremium) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(32),
          child: Text(
            'היומן האישי זמין למשתמשי Premium.',
            textAlign: TextAlign.center,
            style: TextStyle(
              color: AppColors.muted,
              fontSize: 17,
              height: 1.5,
            ),
          ),
        ),
      );
    }

    if (_loading) {
      return const Center(
        child: CircularProgressIndicator(
          strokeWidth: 1.5,
          color: AppColors.brass,
        ),
      );
    }

    if (_error != null) {
      return Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'לא ניתן לטעון את היומן',
              style: TextStyle(
                color: AppColors.ink,
                fontSize: 16,
              ),
            ),
            const SizedBox(height: 12),
            TextButton(
              onPressed: () {
                setState(() {
                  _loading = true;
                  _error = null;
                });
                _loadVisits();
              },
              child: const Text('נסה שוב'),
            ),
          ],
        ),
      );
    }

    if (_visits.isEmpty) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(32),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Icon(
                Icons.menu_book_outlined,
                size: 46,
                color: AppColors.brass,
              ),
              SizedBox(height: 18),
              Text(
                'היומן שלך עדיין ריק',
                style: TextStyle(
                  color: AppColors.ink,
                  fontSize: 22,
                  fontWeight: FontWeight.w500,
                ),
              ),
              SizedBox(height: 8),
              Text(
                'כשתוסיף ביקורים למקומות,\nהם יופיעו כאן באופן אוטומטי.',
                textAlign: TextAlign.center,
                style: TextStyle(
                  color: AppColors.muted,
                  fontSize: 14,
                  height: 1.6,
                ),
              ),
            ],
          ),
        ),
      );
    }

    return RefreshIndicator(
      color: AppColors.brass,
      onRefresh: _loadVisits,
      child: ListView.builder(
        padding: const EdgeInsets.fromLTRB(20, 18, 20, 36),
        itemCount: _visits.length,
        itemBuilder: (context, index) {
          return _buildVisit(_visits[index]);
        },
      ),
    );
  }

  Widget _buildVisit(Map<String, dynamic> visit) {
    final place = visit['places'] is Map
        ? Map<String, dynamic>.from(visit['places'] as Map)
        : <String, dynamic>{};

    final placeName = place['name']?.toString().trim().isNotEmpty == true
        ? place['name'].toString()
        : 'מקום ללא שם';

    final address = place['address']?.toString() ?? '';

    final visitImage = visit['image_url']?.toString() ?? '';
    final placeImage = place['image_url']?.toString() ?? '';

    final imageUrl = visitImage.isNotEmpty ? visitImage : placeImage;

    final rating = _averageRating(visit);

    return Container(
      margin: const EdgeInsets.only(bottom: 18),
      decoration: BoxDecoration(
        color: AppColors.card,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: AppColors.brass.withValues(alpha: 0.18),
          width: 0.8,
        ),
      ),
      clipBehavior: Clip.antiAlias,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          if (imageUrl.isNotEmpty)
            AspectRatio(
              aspectRatio: 1.45,
              child: Image.network(
                imageUrl,
                fit: BoxFit.cover,
                errorBuilder: (_, __, ___) {
                  return const Center(
                    child: Icon(
                      Icons.image_outlined,
                      size: 40,
                      color: AppColors.muted,
                    ),
                  );
                },
              ),
            ),
          Padding(
            padding: const EdgeInsets.fromLTRB(18, 16, 18, 18),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text(
                  placeName,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  textAlign: TextAlign.right,
                  style: const TextStyle(
                    color: AppColors.ink,
                    fontSize: 21,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                if (address.isNotEmpty) ...[
                  const SizedBox(height: 5),
                  Text(
                    address,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    textAlign: TextAlign.right,
                    style: const TextStyle(
                      color: AppColors.muted,
                      fontSize: 13,
                    ),
                  ),
                ],
                const SizedBox(height: 14),
                Row(
                  textDirection: TextDirection.ltr,
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text(
                      _formatDate(visit['created_at']?.toString()),
                      style: const TextStyle(
                        color: AppColors.muted,
                        fontSize: 12,
                      ),
                    ),
                    if (rating != null)
                      Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          const Icon(
                            Icons.star,
                            size: 18,
                            color: AppColors.brass,
                          ),
                          const SizedBox(width: 5),
                          Text(
                            rating.toStringAsFixed(1),
                            style: const TextStyle(
                              color: AppColors.ink,
                              fontSize: 14,
                              fontWeight: FontWeight.w600,
                            ),
                          ),
                        ],
                      ),
                  ],
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
