import 'package:supabase_flutter/supabase_flutter.dart';
import 'package:flutter/material.dart';

import '../screens/admin_notifications_screen.dart';
import '../utils/permissions.dart';
import '../theme/colors.dart';

class AdminNotificationButton extends StatefulWidget {
  const AdminNotificationButton({super.key});

  @override
  State<AdminNotificationButton> createState() =>
      _AdminNotificationButtonState();
}

class _AdminNotificationButtonState extends State<AdminNotificationButton> {
  bool _loading = true;
  int _reportsCount = 0;

  @override
  void initState() {
    super.initState();
    _loadPermissions();
  }

  Future<void> _loadPermissions() async {
    await Permissions.load();

    if (!mounted) return;

    if (Permissions.isAdmin) {
      try {
        final result = await Supabase.instance.client
            .from('visit_image_reports')
            .select('id')
            .isFilter('resolved_at', null);

        _reportsCount = (result as List).length;
      } catch (_) {
        _reportsCount = 0;
      }
    }

    if (!mounted) return;

    setState(() {
      _loading = false;
    });
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();

    if (!_loading && Permissions.isAdmin) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (!mounted) return;

        Permissions.load().then((_) {
          if (mounted) {
            setState(() {});
          }
        });
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_loading || !Permissions.isAdmin) {
      return const SizedBox.shrink();
    }

    return Stack(
      clipBehavior: Clip.none,
      children: [
        IconButton(
          tooltip: 'התראות',
          icon: const Icon(
            Icons.notifications_none_outlined,
            color: AppColors.brass,
            size: 23,
          ),
          onPressed: () async {
            await Navigator.of(context).push(
              MaterialPageRoute(
                builder: (_) => const AdminNotificationsScreen(),
              ),
            );

            if (mounted) {
              _loadPermissions();
            }
          },
        ),
        if (_reportsCount > 0)
          Positioned(
            top: 6,
            right: 5,
            child: Container(
              constraints: const BoxConstraints(
                minWidth: 16,
                minHeight: 16,
              ),
              padding: const EdgeInsets.symmetric(horizontal: 4),
              decoration: BoxDecoration(
                color: AppColors.brass,
                borderRadius: BorderRadius.circular(10),
              ),
              alignment: Alignment.center,
              child: Text(
                _reportsCount > 99 ? '99+' : '$_reportsCount',
                style: const TextStyle(
                  color: AppColors.background,
                  fontSize: 9,
                  fontWeight: FontWeight.w700,
                ),
              ),
            ),
          ),
      ],
    );
  }
}
