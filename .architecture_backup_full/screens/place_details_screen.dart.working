import 'dart:convert';

import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';
import 'package:geolocator/geolocator.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:url_launcher/url_launcher.dart';

import '../models/place.dart';
import '../models/place_visit.dart';
import '../repositories/firebase_place_repository.dart';
import '../services/location_service.dart';

class PlaceDetailsScreen extends StatefulWidget {
  final Place place;
  final bool myContentOnly;

  const PlaceDetailsScreen({
    super.key,
    required this.place,
    this.myContentOnly = false,
  });

  @override
  State<PlaceDetailsScreen> createState() => _PlaceDetailsScreenState();
}

class _PlaceDetailsScreenState extends State<PlaceDetailsScreen> {
  final FirebasePlaceRepository repository = FirebasePlaceRepository();

  String? defaultNavigation;
  Position? currentPosition;

  @override
  void initState() {
    super.initState();
    loadNavigation();
    loadLocation();
  }

  Future<void> loadNavigation() async {
    final prefs = await SharedPreferences.getInstance();

    if (!mounted) return;

    setState(() {
      defaultNavigation = prefs.getString('default_navigation');
    });
  }

  Future<void> loadLocation() async {
    final position = await LocationService.getCurrentLocation();

    if (position != null && mounted) {
      setState(() {
        currentPosition = position;
      });
    }
  }

  bool hasLocation() {
    return widget.place.latitude != 0 && widget.place.longitude != 0;
  }

  String getDistance() {
    if (currentPosition == null || !hasLocation()) {
      return '';
    }

    final meters = Geolocator.distanceBetween(
      currentPosition!.latitude,
      currentPosition!.longitude,
      widget.place.latitude,
      widget.place.longitude,
    );

    if (meters < 1000) {
      return '${meters.round()} מטר ממך';
    }

    return '${(meters / 1000).toStringAsFixed(1)} ק״מ ממך';
  }

  Future<void> navigate(String type) async {
    if (!hasLocation()) return;

    final lat = widget.place.latitude;
    final lng = widget.place.longitude;

    late final Uri url;

    if (type == 'waze') {
      url = Uri.parse(
        'https://waze.com/ul?ll=$lat,$lng&navigate=yes',
      );
    } else if (type == 'apple') {
      url = Uri.parse(
        'https://maps.apple.com/?daddr=$lat,$lng',
      );
    } else {
      url = Uri.parse(
        'https://www.google.com/maps/search/?api=1&query=$lat,$lng',
      );
    }

    await launchUrl(
      url,
      mode: LaunchMode.externalApplication,
    );
  }

  Future<void> chooseNavigation() async {
    if (!hasLocation()) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('אין מיקום GPS למקום הזה'),
        ),
      );

      return;
    }

    if (defaultNavigation != null) {
      await navigate(defaultNavigation!);
      return;
    }

    String selected = 'google';
    bool remember = false;

    await showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('בחר ניווט'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  RadioGroup<String>(
                    groupValue: selected,
                    onChanged: (value) {
                      setDialogState(() {
                        selected = value!;
                      });
                    },
                    child: Column(
                      children: [
                        const RadioListTile<String>(
                          value: 'google',
                          title: Text('Google Maps'),
                        ),
                        const RadioListTile<String>(
                          value: 'waze',
                          title: Text('Waze'),
                        ),
                        const RadioListTile<String>(
                          value: 'apple',
                          title: Text('Apple Maps'),
                        ),
                      ],
                    ),
                  ),
                  CheckboxListTile(
                    value: remember,
                    title: const Text('זכור בחירה'),
                    onChanged: (value) {
                      setDialogState(() {
                        remember = value ?? false;
                      });
                    },
                  ),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(context),
                  child: const Text('ביטול'),
                ),
                FilledButton(
                  onPressed: () async {
                    Navigator.pop(context);

                    if (remember) {
                      final prefs = await SharedPreferences.getInstance();

                      await prefs.setString(
                        'default_navigation',
                        selected,
                      );

                      defaultNavigation = selected;
                    }

                    await navigate(selected);
                  },
                  child: const Text('פתח'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  Future<void> addVisit() async {
    // בשלב הבא נחבר לכאן את מסך הוספת הביקור החדש.
    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('מסך הוספת ביקור למקום יתווסף בשלב הבא'),
      ),
    );
  }

  Future<void> toggleFavorite() async {
    setState(() {
      widget.place.favorite = !widget.place.favorite;
    });

    await repository.updatePlace(widget.place);
  }

  Future<void> deletePlace() async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('מחיקת מקום'),
          content: const Text('האם למחוק את המקום?'),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context, false),
              child: const Text('ביטול'),
            ),
            FilledButton(
              onPressed: () => Navigator.pop(context, true),
              child: const Text('מחיקה'),
            ),
          ],
        );
      },
    );

    if (confirm != true) return;

    await repository.deletePlace(widget.place);

    if (mounted) {
      Navigator.pop(context);
    }
  }

  Widget infoRow({
    required IconData icon,
    required String text,
  }) {
    return Padding(
      padding: const EdgeInsets.only(top: 7),
      child: Row(
        children: [
          Icon(
            icon,
            size: 18,
            color: Colors.grey.shade700,
          ),
          const SizedBox(width: 7),
          Expanded(
            child: Text(
              text,
              style: TextStyle(
                fontSize: 14,
                color: Colors.grey.shade700,
              ),
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final distance = getDistance();

    final currentUserId = FirebaseAuth.instance.currentUser?.uid;

    final visits = widget.myContentOnly
        ? widget.place.visits
            .where(
              (visit) => visit.userId == currentUserId,
            )
            .toList()
        : widget.place.visits;

    final isGuest = FirebaseAuth.instance.currentUser?.isAnonymous == true;

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        backgroundColor: const Color(0xFFF7F5F1),
        appBar: AppBar(
          backgroundColor: const Color(0xFFF7F5F1),
          elevation: 0,
          title: Text(
            widget.place.name,
            style: const TextStyle(
              fontWeight: FontWeight.w600,
            ),
          ),
          actions: [
            if (hasLocation())
              IconButton(
                tooltip: 'ניווט',
                icon: const Icon(
                  Icons.navigation_outlined,
                ),
                onPressed: chooseNavigation,
              ),
            IconButton(
              tooltip: 'מועדף',
              icon: Icon(
                widget.place.favorite ? Icons.favorite : Icons.favorite_border,
              ),
              onPressed: toggleFavorite,
            ),
          ],
        ),
        floatingActionButton: isGuest
            ? null
            : FloatingActionButton.extended(
                onPressed: addVisit,
                icon: const Icon(Icons.add),
                label: Text(
                  'ביקור',
                ),
              ),
        body: ListView(
          padding: const EdgeInsets.fromLTRB(
            16,
            8,
            16,
            100,
          ),
          children: [
            if (widget.place.imageBase64.isNotEmpty)
              ClipRRect(
                borderRadius: BorderRadius.circular(22),
                child: Image.memory(
                  base64Decode(
                    widget.place.imageBase64,
                  ),
                  height: 210,
                  width: double.infinity,
                  fit: BoxFit.cover,
                ),
              ),
            const SizedBox(height: 18),
            Text(
              widget.place.name,
              style: const TextStyle(
                fontSize: 30,
                fontWeight: FontWeight.w700,
              ),
            ),
            const SizedBox(height: 6),
            infoRow(
              icon: Icons.location_on_outlined,
              text: widget.place.location,
            ),
            if (widget.place.ownerName.isNotEmpty)
              infoRow(
                icon: Icons.person_outline,
                text: 'נוצר על ידי: ${widget.place.ownerName}',
              ),
            if (widget.place.createdAt != null)
              infoRow(
                icon: Icons.calendar_today_outlined,
                text:
                    'בתאריך: ${widget.place.createdAt!.day}/${widget.place.createdAt!.month}/${widget.place.createdAt!.year}',
              ),
            if (distance.isNotEmpty)
              infoRow(
                icon: Icons.near_me_outlined,
                text: distance,
              ),
            const SizedBox(height: 22),
            Row(
              children: [
                const Icon(
                  Icons.star,
                  size: 20,
                ),
                const SizedBox(width: 6),
                Text(
                  widget.place.score.toStringAsFixed(1),
                  style: const TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                const SizedBox(width: 20),
                Text(
                  '${widget.place.visitsCount} ביקורים',
                  style: TextStyle(
                    color: Colors.grey.shade700,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 20),
            if (hasLocation())
              SizedBox(
                height: 48,
                child: OutlinedButton.icon(
                  onPressed: chooseNavigation,
                  icon: const Icon(
                    Icons.navigation_outlined,
                  ),
                  label: const Text('נווט למקום'),
                ),
              ),
            const SizedBox(height: 24),
            if (visits.isEmpty)
              Container(
                padding: const EdgeInsets.all(22),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Column(
                  children: [
                    Icon(
                      Icons.place_outlined,
                      size: 42,
                      color: Colors.grey.shade500,
                    ),
                    const SizedBox(height: 10),
                    const Text(
                      'עדיין אין ביקורים',
                      style: TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(
                      isGuest
                          ? 'התחבר כדי להוסיף ביקור'
                          : 'הוסף את הביקור הראשון שלך',
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        color: Colors.grey.shade600,
                      ),
                    ),
                  ],
                ),
              )
            else ...[
              const Text(
                'ביקורים',
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.w700,
                ),
              ),
              const SizedBox(height: 12),
              ...visits.map(
                (visit) {
                  final placeVisit = visit as PlaceVisit;

                  return Container(
                    margin: const EdgeInsets.only(
                      bottom: 10,
                    ),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(18),
                    ),
                    child: ListTile(
                      contentPadding: const EdgeInsets.symmetric(
                        horizontal: 16,
                        vertical: 8,
                      ),
                      title: Text(
                        placeVisit.itemName,
                        style: const TextStyle(
                          fontWeight: FontWeight.w600,
                          fontSize: 17,
                        ),
                      ),
                      subtitle: placeVisit.notes.trim().isEmpty
                          ? null
                          : Padding(
                              padding: const EdgeInsets.only(
                                top: 5,
                              ),
                              child: Text(
                                placeVisit.notes,
                                maxLines: 3,
                                overflow: TextOverflow.ellipsis,
                              ),
                            ),
                    ),
                  );
                },
              ),
            ],
            if (!isGuest) ...[
              const SizedBox(height: 24),
              TextButton(
                onPressed: deletePlace,
                style: TextButton.styleFrom(
                  foregroundColor: Colors.red.shade700,
                ),
                child: const Text(
                  'מחיקת מקום',
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}
